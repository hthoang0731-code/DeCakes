{
  "info": {
    "_postman_id": "6a0f3a52-6f8e-4d6b-9a3e-2d1c7f5b8e41",
    "name": "DeCakes — nghiệm thu email tài khoản",
    "description": "Chỉ gồm luồng đăng ký → xác minh email, gửi lại email, quên/đặt lại mật khẩu, đổi mật khẩu và thu hồi phiên. Request ghi bị khóa tới khi đặt scopeConfirmed = yes. Không có mật khẩu, token hay khóa trong file. Xem tools/postman/README.md, mục Nghiệm thu email.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Chỉ gọi API cục bộ qua HTTPS và đúng các endpoint nghiệm thu email tài khoản.",
          "// Lỗi được ném ra để Postman hiển thị trong vùng response; không bỏ qua request âm thầm.",
          "const target = pm.variables.replaceIn(pm.request.url.toString());",
          "const m = /^https:\\/\\/(localhost|127\\.0\\.0\\.1):\\d+(\\/api\\/[a-z\\/-]+)$/.exec(target);",
          "if (!m) throw new Error('URL phải là https://localhost:<cổng>/api/... hoặc https://127.0.0.1:<cổng>/api/... Kiểm tra baseUrl/baseUrlB (không có / ở cuối).');",
          "const op = pm.request.method + ' ' + m[2];",
          "const readOnly = ['GET /api/health', 'GET /api/auth/csrf', 'GET /api/auth/me', 'POST /api/auth/login', 'POST /api/auth/logout'];",
          "const scoped = ['POST /api/auth/register', 'POST /api/auth/email-verification/resend', 'POST /api/auth/email-verification/confirm',",
          "  'POST /api/auth/password/forgot', 'POST /api/auth/password/reset', 'POST /api/auth/password/change'];",
          "if (!readOnly.includes(op) && !scoped.includes(op)) throw new Error(op + ' không thuộc phạm vi nghiệm thu email tài khoản.');",
          "if (scoped.includes(op) && pm.environment.get('scopeConfirmed') !== 'yes') {",
          "  throw new Error('Request ghi tài khoản đang khóa. Chỉ đặt scopeConfirmed = yes sau khi đã xác nhận phạm vi nghiệm thu (tools/postman/README.md, mục Nghiệm thu email).');",
          "}",
          "// Dựng lại body bằng JSON.stringify để mật khẩu có dấu nháy/backslash không làm hỏng JSON.",
          "// Giá trị gõ thẳng vào body (không phải {{biến}}) được giữ nguyên; body không phải JSON được gửi nguyên để server báo lỗi.",
          "if (pm.request.body && pm.request.body.mode === 'raw' && pm.request.body.raw) {",
          "  let body = null;",
          "  try { body = JSON.parse(pm.request.body.raw); } catch (e) { body = null; }",
          "  if (body && typeof body === 'object' && !Array.isArray(body)) {",
          "    for (const k of Object.keys(body)) { if (typeof body[k] === 'string') body[k] = pm.variables.replaceIn(body[k]); }",
          "    pm.request.body.update(JSON.stringify(body));",
          "  }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code >= 400) {",
          "  pm.test('Lỗi không lộ chuỗi kết nối hoặc stack trace', () => pm.expect(pm.response.text()).not.to.match(/(?:password_hash|MySqlException|at DeCakes\\.|Server=[^;]+;Port=)/i));",
          "}"
        ]
      }
    }
  ],
